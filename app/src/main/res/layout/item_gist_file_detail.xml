<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- File name + language -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_background"
                android:textSize="14sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tvFileLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/orange_text"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

        </LinearLayout>

        <!-- Content (scrollable, max-height diatur programmatically) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="400dp">

            <TextView
                android:id="@+id/tvFileContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="12sp"
                android:typeface="monospace"
                android:background="@color/surface_variant"
                android:padding="10dp"
                android:textIsSelectable="true"
                android:scrollbars="vertical" />

        </ScrollView>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressFile"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/primary"
            style="?android:attr/progressBarStyleSmall" />

        <!-- Show More / Open Raw button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowMore"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center"
            android:textSize="12sp"
            android:textColor="@color/on_background"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="6dp"
            android:visibility="gone"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnEditFile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✏️ Edit"
                android:textSize="12sp"
                android:textColor="@color/on_background"
                android:backgroundTint="@color/surface_variant"
                app:cornerRadius="6dp"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnCopyFile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Copy"
                android:textSize="12sp"
                android:textColor="@color/on_background"
                android:backgroundTint="@color/surface_variant"
                app:cornerRadius="6dp"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnOpenRaw"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Open Raw"
                android:textSize="12sp"
                android:textColor="@color/on_background"
                android:backgroundTint="@color/surface_variant"
                app:cornerRadius="6dp"
                android:layout_marginStart="8dp"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
